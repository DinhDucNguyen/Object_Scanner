Streak --> Router: List<NgayOnTap>
Router --> App: List<NgayOnTap>
App --> User: hien_thi_lich_streak()

note over App, Router
    Endpoint record_review ton tai de tuong thich/dong bo,
    nhung man hinh Streak hien tai khong co nut diem danh
    va khong goi record_review truc tiep.
end note
@enduml

@startuml
title 9. Admin duyet ket qua AI

actor "Quan tri vien" as Admin
boundary "AdminWeb" as Web
control "PredictionRouter" as Router
control "PredictionService" as Prediction
control "TTSService" as TTS
database "Database" as DB

Admin -> Web: mo_danh_sach_du_doan_cho_duyet()
Web -> Router: list_predictions(trang_thai, limit, offset, search)
Router -> Prediction: list_predictions(trang_thai, limit, offset, search)
Prediction -> DB: lay_du_doan_cho_duyet()
DB --> Prediction: List<DuDoanAI>
Prediction --> Router: List<DuDoanAI>
Router --> Web: List<DuDoanAI>
Web --> Admin: hien_thi_danh_sach_du_doan()

Admin -> Web: chon_duyet_du_doan()
Web -> Router: approve_prediction(du_doan_ai_id, yeu_cau, admin_id)
Router -> Prediction: approve_prediction(du_doan_ai_id, yeu_cau, admin_id)
Prediction -> DB: lay_du_doan_ai()
Prediction -> DB: tao_hoac_cap_nhat_doi_tuong()

loop Voi moi ban dich trong du doan
    Prediction -> TTS: get_audio_url(word_name, lang_code)
    TTS --> Prediction: audio_url
    Prediction -> DB: tao_hoac_cap_nhat_ngon_ngu_neu_can()
    Prediction -> DB: tao_hoac_cap_nhat_ban_dich(audio_url)
    Prediction -> DB: luu_vi_du()
end

Prediction -> DB: gan_nguoi_dung_vao_tien_do_hoc_neu_can()
Prediction -> DB: cap_nhat_trang_thai_du_doan()
Prediction -> DB: cap_nhat_anh_huan_luyen_lien_quan()
Prediction --> Router: boolean
Router --> Web: ket_qua_duyet
Web --> Admin: thong_bao_duyet_thanh_cong()
@enduml
