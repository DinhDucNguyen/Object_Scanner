@startuml
title 8. Xem thong ke chuoi on tap (Streak)

actor "Nguoi dung" as User
boundary "AndroidApp" as App
control "StreakRouter" as Router
control "StreakService" as Streak
database "Database" as DB

User -> App: mo_man_hinh_streak()
App -> Router: get_streak(nguoi_dung_id)
Router -> Streak: get_streak(nguoi_dung_id)
Streak -> DB: tinh_chuoi_on_tap_tu_lich_su()
DB --> Streak: thong_ke_streak
Streak --> Router: dict
Router --> App: dict
App --> User: hien_thi_chuoi_on_tap()

App -> Router: get_calendar(nguoi_dung_id, days)
Router -> Streak: get_calendar(nguoi_dung_id, days)
Streak -> DB: lay_lich_on_tap_theo_ngay()
