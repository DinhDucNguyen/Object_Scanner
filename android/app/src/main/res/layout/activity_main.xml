<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        android:elevation="0dp"
        app:title="Object Language"
        app:titleTextColor="@color/text_primary"
        app:titleTextAppearance="@style/TextAppearance.App.ToolbarTitle"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/offlineBanner"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@color/warning"
        android:gravity="center"
        android:text="@string/offline_banner"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph"
        app:layout_constraintTop_toBottomOf="@id/offlineBanner"
        app:layout_constraintBottom_toTopOf="@id/customBottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/customBottomNav"
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:background="@drawable/bg_bottom_nav_container"
        android:elevation="12dp"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/navTabHome"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_bottom_nav_item_idle"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/navTabDictionary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView
                android:id="@+id/navIconHome"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_home"
                android:src="@drawable/ic_home"
                app:tint="@color/bottom_nav_inactive" />
            <TextView
                android:id="@+id/navLabelHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_home"
                android:textSize="12sp"
                android:textColor="@color/bottom_nav_inactive" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTabDictionary"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_bottom_nav_item_idle"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintStart_toEndOf="@id/navTabHome"
            app:layout_constraintEnd_toStartOf="@id/navTabScan"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView
                android:id="@+id/navIconDictionary"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_dictionary"
                android:src="@drawable/ic_dictionary"
                app:tint="@color/bottom_nav_inactive" />
            <TextView
                android:id="@+id/navLabelDictionary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_dictionary"
                android:textSize="12sp"
                android:textColor="@color/bottom_nav_inactive" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTabScan"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_bottom_nav_item_idle"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintStart_toEndOf="@id/navTabDictionary"
            app:layout_constraintEnd_toStartOf="@id/navTabReview"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintWidth_percent="0.2">
            <ImageView
                android:id="@+id/navIconScan"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_bottom_nav_scan_button_idle"
                android:contentDescription="@string/nav_scan"
                android:padding="10dp"
                android:src="@drawable/ic_scan"
                app:tint="@color/primary" />
            <TextView
                android:id="@+id/navLabelScan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_scan"
                android:textSize="12sp"
                android:textColor="@color/bottom_nav_inactive" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/navTabReview"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_bottom_nav_item_idle"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintStart_toEndOf="@id/navTabScan"
            app:layout_constraintEnd_toStartOf="@id/navTabProfile"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                tools:ignore="UselessParent">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/navIconReview"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/nav_review"
                        android:src="@drawable/ic_book"
                        app:tint="@color/bottom_nav_inactive" />

                    <TextView
                        android:id="@+id/tvReviewBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginStart="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_badge_red"
                        android:gravity="center"
                        android:minWidth="16dp"
                        android:minHeight="16dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:id="@+id/navLabelReview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/nav_review"
                    android:textSize="12sp"
                    android:textColor="@color/bottom_nav_inactive" />

            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/navTabProfile"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_bottom_nav_item_idle"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintStart_toEndOf="@id/navTabReview"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView
                android:id="@+id/navIconProfile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_profile"
                android:src="@drawable/ic_person"
                app:tint="@color/bottom_nav_inactive" />
            <TextView
                android:id="@+id/navLabelProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_profile"
                android:textSize="12sp"
                android:textColor="@color/bottom_nav_inactive" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
