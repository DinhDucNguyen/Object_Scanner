<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="22dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/scan_model_options_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/scan_model_options_subtitle"
        android:textAppearance="@style/TextAppearance.App.BodyMedium" />

    <RadioGroup
        android:id="@+id/radioModelGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/radioCocoModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/primary"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/scan_model_coco"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="10dp"
            android:text="@string/scan_model_coco_desc"
            android:textAppearance="@style/TextAppearance.App.BodySmall" />

        <RadioButton
            android:id="@+id/radioCustomModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/primary"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/scan_model_custom"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:text="@string/scan_model_custom_desc"
            android:textAppearance="@style/TextAppearance.App.BodySmall" />
    </RadioGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseModelOptions"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="22dp"
        android:text="@string/btn_close"
        android:textAllCaps="false"
        app:backgroundTint="@color/primary"
        app:cornerRadius="16dp" />
</LinearLayout>
