<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="20dp">

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Finished message -->
    <TextView
        android:id="@+id/tvFinished"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/review_finished"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:visibility="gone" />

    <!-- Card content -->
    <LinearLayout
        android:id="@+id/cardContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Progress -->
        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1 / 10"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/divider">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="28dp">

                <!-- Front: English word + phonetic + POS -->
                <TextView
                    android:id="@+id/tvQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="word"
                    android:textColor="@color/text_primary"
                    android:textSize="38sp"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvPhonetic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_secondary"
                    android:textSize="18sp"
                    android:textAlignment="center"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvLangHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🇺🇸 English"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:textAlignment="center"
                    android:layout_marginBottom="28dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReveal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/review_btn_reveal"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp"
                    app:backgroundTint="@color/primary" />

                <!-- Back: definition + example (shown after reveal) -->
                <LinearLayout
                    android:id="@+id/layoutAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <View
                        android:layout_width="60dp"
                        android:layout_height="2dp"
                        android:background="@color/divider"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/tvAnswerDefinition"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/primary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvAnswerExample"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:textStyle="italic"
                        android:textAlignment="center"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- 4 quality buttons in 2x2 grid -->
    <LinearLayout
        android:id="@+id/buttonRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAgain"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="❌ Quên"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                android:textColor="@color/text_on_primary"
                app:backgroundTint="#EF5350"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHard"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="😓 Khó"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                android:textColor="@color/text_on_primary"
                app:backgroundTint="#FF7043"
                android:layout_marginStart="6dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGood"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="✅ Ổn"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                android:textColor="@color/text_on_primary"
                app:backgroundTint="@color/success"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEasy"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="⭐ Dễ"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                android:textColor="@color/text_on_primary"
                app:backgroundTint="#42A5F5"
                android:layout_marginStart="6dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
