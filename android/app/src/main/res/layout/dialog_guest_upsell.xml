<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical">

    <!-- Gradient header banner -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/bg_dialog_header_primary">

        <!-- Decorative circle top-right -->
        <View
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-20dp"
            android:layout_marginEnd="-20dp"
            android:alpha="0.15"
            android:background="@drawable/circle_bg" />

        <!-- Decorative circle bottom-left -->
        <View
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="-10dp"
            android:layout_marginBottom="-10dp"
            android:alpha="0.10"
            android:background="@drawable/circle_bg" />

        <!-- Icon circle in center -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_dialog_icon_circle">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_lock"
                app:tint="@android:color/white" />
        </FrameLayout>

        <!-- Brand tag bottom-center -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:alpha="0.7"
            android:letterSpacing="0.12"
            android:text="@string/app_name"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_body_bottom"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="28dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Message -->
        <TextView
            android:id="@+id/tvDialogMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Login button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogLogin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:text="@string/guest_btn_login"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_person"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="@android:color/white" />

        <!-- Register button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogRegister"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:text="@string/guest_btn_register"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:strokeColor="@color/primary"
            app:strokeWidth="1.5dp" />

        <!-- Later link -->
        <TextView
            android:id="@+id/tvDialogLater"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/guest_btn_later"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>
